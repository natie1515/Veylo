+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import {z} from 'zod';
+
+const ProfileColor = z.number().int().min(0).max(0xffffff);
+
+export const ProfileAppearanceSchema = z.strictObject({
+	theme: z.strictObject({primary: ProfileColor, accent: ProfileColor}).nullable(),
+	name_style: z.strictObject({
+		font: z.enum(['default', 'modern', 'serif', 'mono']),
+		effect: z.enum(['solid', 'gradient', 'neon', 'cartoon', 'pop', 'candy', 'prism']),
+		colors: z.array(ProfileColor).min(1).max(5),
+	}).nullable(),
+});
+
+export type ProfileAppearance = z.infer<typeof ProfileAppearanceSchema>;
