diff --git a/fluxer_app/src/features/user/components/profile/ProfileAppearance.tsx b/fluxer_app/src/features/user/components/profile/ProfileAppearance.tsx
new file mode 100644
index 0000000..fe051f8
--- /dev/null
+++ b/fluxer_app/src/features/user/components/profile/ProfileAppearance.tsx
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import type {ProfileAppearance} from '@fluxer/schema/src/domains/user/ProfileAppearanceSchema';
+import type {CSSProperties} from 'react';
+import {Trans} from '@lingui/react/macro';
+
+const fonts = {
+	default: 'inherit',
+	modern: 'system-ui, sans-serif',
+	serif: 'Georgia, serif',
+	mono: 'monospace',
+} as const;
+
+const hex = (color: number) => `#${color.toString(16).padStart(6, '0')}`;
+
+export function profileThemeStyle(theme: ProfileAppearance['theme'] | undefined): CSSProperties | undefined {
+	if (!theme) return undefined;
+	return {backgroundImage: `linear-gradient(160deg, ${hex(theme.primary)}55, ${hex(theme.accent)}77)`};
+}
+
+export function profileNameStyle(style: ProfileAppearance['name_style'] | undefined): CSSProperties | undefined {
+	if (!style) return undefined;
+	const colors = style.colors.map(hex);
+	const color = colors[0];
+	const fontFamily = fonts[style.font];
+	switch (style.effect) {
+		case 'gradient':
+		case 'prism':
+		case 'candy':
+			return {
+				fontFamily,
+				color,
+				...(colors.length > 1 && {
+					backgroundImage: `linear-gradient(90deg, ${colors.join(', ')})`,
+					backgroundClip: 'text',
+					WebkitTextFillColor: 'transparent',
+				}),
+			};
+		case 'neon':
+			return {fontFamily, color, textShadow: `0 0 6px ${color}, 0 0 12px ${color}`};
+		case 'pop':
+			return {fontFamily, color, textShadow: '2px 2px currentColor'};
+		case 'cartoon':
+			return {fontFamily, color, fontWeight: 900, WebkitTextStroke: '1px var(--background-primary)'};
+		default:
+			return {fontFamily, color};
+	}
+}
+
+const defaultTheme = {primary: 0x387daa, accent: 0xb548c4};
+const defaultName: NonNullable<ProfileAppearance['name_style']> = {
+	font: 'modern',
+	effect: 'prism',
+	colors: [0x7ee7d8, 0x7ccbff, 0x7f8cff, 0xb56dff, 0xf38bd9],
+};
+
+const fontLabels = {default: 'Predeterminada', modern: 'Moderna', serif: 'Clásica', mono: 'Monoespaciada'};
+const effectLabels = {
+	solid: 'Liso', gradient: 'Degradado', neon: 'Neón', cartoon: 'Dibujo animado', pop: 'Pop', candy: 'Gominola', prism: 'Prisma',
+};
+
+interface Props {
+	value: ProfileAppearance | null | undefined;
+	onChange: (value: ProfileAppearance | null) => void;
+	displayName: string;
+	premium: boolean;
+	disabled: boolean;
+	section: 'theme' | 'name_style';
+}
+
+export function ProfileAppearanceEditor({value, onChange, displayName, premium, disabled, section}: Props) {
+	const appearance = value ?? {theme: null, name_style: null};
+	const theme = appearance.theme ?? defaultTheme;
+	const name = appearance.name_style ?? defaultName;
+	const preview = (
+		<div style={{padding: '1rem', borderRadius: '0.75rem', backgroundColor: 'var(--background-primary)', ...profileThemeStyle(appearance.theme)}}>
+			<strong style={profileNameStyle(appearance.name_style)}>{displayName}</strong>
+		</div>
+	);
+	return (
+		<fieldset disabled={disabled || !premium} style={{display: 'grid', gap: '0.75rem', minWidth: 0}}>
+			<legend>{section === 'theme' ? <Trans>Tema del perfil</Trans> : <Trans>Estilo del nombre de visualización</Trans>}</legend>
+			{!premium ? <span><Trans>Premium</Trans></span> : section === 'theme' ? (
+				<>
+					{preview}
+					<div style={{display: 'flex', gap: '1rem'}}>
+						{(['primary', 'accent'] as const).map((key) => (
+							<label key={key}>
+								{key === 'primary' ? <Trans>Primario</Trans> : <Trans>Realce</Trans>}
+								<input type="color" value={hex(theme[key])} onChange={(event) => {
+									onChange({...appearance, theme: {...theme, [key]: Number.parseInt(event.target.value.slice(1), 16)}});
+								}} />
+							</label>
+						))}
+					</div>
+					{appearance.theme && <button type="button" onClick={() => onChange({...appearance, theme: null})}><Trans>Restablecer tema</Trans></button>}
+				</>
+			) : (
+				<>
+					{preview}
+					<label><Trans>Fuente</Trans>{' '}
+						<select value={name.font} onChange={(event) => onChange({...appearance, name_style: {...name, font: event.target.value as typeof name.font}})}>
+							{Object.entries(fontLabels).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
+						</select>
+					</label>
+					<label><Trans>Efecto</Trans>{' '}
+						<select value={name.effect} onChange={(event) => onChange({...appearance, name_style: {...name, effect: event.target.value as typeof name.effect}})}>
+							{Object.entries(effectLabels).map(([key, label]) => <option key={key} value={key}>{label}</option>)}
+						</select>
+					</label>
+					<div style={{display: 'flex', flexWrap: 'wrap', gap: '0.5rem'}}>
+						{(name.effect === 'prism' ? defaultName.colors : name.effect === 'gradient' || name.effect === 'candy' ? defaultName.colors.slice(0, 2) : defaultName.colors.slice(0, 1)).map((fallback, index, palette) => (
+							<label key={fallback}><Trans>Color</Trans> {index + 1}
+								<input type="color" value={hex(name.colors[index] ?? fallback)} onChange={(event) => {
+									const colors = palette.map((color, position) => name.colors[position] ?? color);
+									colors[index] = Number.parseInt(event.target.value.slice(1), 16);
+									onChange({...appearance, name_style: {...name, colors}});
+								}} />
+							</label>
+						))}
+					</div>
+					<button type="button" onClick={() => onChange({...appearance, name_style: {
+						...defaultName,
+						colors: defaultName.colors.map(() => Math.floor(Math.random() * 0x1000000)),
+					}})}><Trans>Sorpréndeme</Trans></button>
+					{appearance.name_style && <button type="button" onClick={() => onChange({...appearance, name_style: null})}><Trans>Eliminar estilo</Trans></button>}
+				</>
+			)}
+		</fieldset>
+	);
+}
